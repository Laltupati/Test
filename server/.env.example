# Azure Monitor / Log Analytics
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_SUBSCRIPTION_ID=
# Used as the preferred subscription; health monitoring also searches other subscriptions visible to the managed identity when an App Service is not found here.
# The managed identity needs Reader (or equivalent read permissions) on each monitored subscription.
# Required for generic HTTP 403 reconciliation when an app has no explicit resource-group mapping.
# Grant the GenAI Playground managed identity Reader at this subscription scope.
AZURE_RESOURCE_GROUP=

# Health monitoring
# The monitoring managed identity needs Microsoft.Web/sites/read and
# Microsoft.Web/sites/config/list/action on mapped App Services to verify
# required setting presence and Key Vault reference resolution (values are never stored).
LOG_MONITOR_INTERVAL_MS=60000
HEALTH_FAILURE_CONFIRMATION_CYCLES=2
HEALTH_CHECK_CONCURRENCY=3
ENABLE_AUTO_RESTART=false

# Owner email notifications (no SMTP required)
# Configure a Logic App with an HTTPS Request trigger and an email action.
# The health monitor POSTs app state, owner ("to"), optional "cc", subject,
# last error, and remediation when the app is degraded, unavailable, or stopped.
# Have the Logic App return HTTP 2xx only after its email action succeeds.
# Set the Logic App callback URL as a server App Service setting; never commit it.
OWNER_NOTIFICATION_WEBHOOK_URL=
OWNER_NOTIFICATION_CC=laltupati@kpmg.com

# Multi-resource application mapping (frontend App Service + backend App Service / Function App)
# JSON object keyed by GenAI Playground application id (preferred) or title.
# Use this when backend App Service names do not follow the frontend->backend naming convention.
# Each entry may specify name + optional resourceGroup, role/type, or a complete resourceId. Function Apps are Microsoft.Web/sites resources too.
# Example:
# Example includes a Function App backend for Proscreener:
# AZURE_APP_RESOURCE_MAP_JSON={"proscreener":[{"role":"frontend","name":"proscreener-h2fjfthwd7g3hmez","resourceGroup":"<proscreener-rg>"},{"role":"backend-function","name":"<proscreener-function-app-name>","resourceGroup":"<proscreener-rg>"}],"resume-creator":[{"role":"frontend","name":"ue-kgs-resumecreationformatting01","resourceGroup":"go-rg-m-dev-inc-kgs-oai22"},{"role":"backend","name":"ue-kgs-resumecreationformattingbackend01","resourceGroup":"go-rg-m-dev-inc-kgs-oai22"}],"augmented-insights-discovery":[{"role":"frontend","name":"ue-kgs-aidegraphragfrontend01"},{"role":"backend","name":"ue-kgs-aidegraphragbackend01"}]}
# Shared dependency resource mapping: one dependency resource can be consumed by multiple applications.
# Map the real Azure resource ID/name for the shared Neo4j service to every consuming app id.
# The same resource telemetry is then attributed to all listed applications.
# AZURE_SHARED_DEPENDENCY_RESOURCE_MAP_JSON={"neo4j":{"applications":["advisor-intelligence","kpmg-agenda-creator"],"resources":[{"role":"shared-dependency","resourceId":"/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/<provider>/<resource-type>/<resource-name>"}]}}
# For launch URLs whose App Service name contains "frontend", automatically infer a same-resource-group backend by replacing frontend -> backend.
AZURE_AUTO_DISCOVER_FRONTEND_BACKEND=true

# Usage & Cost - multiple resource groups
# Comma-separated list of every RG associated with GenAI Playground apps.
# The code also discovers useCase.azureResourceGroup and mapped resourceGroup values.
AZURE_COST_RESOURCE_GROUPS=
# true = auto-discover every resource group in AZURE_SUBSCRIPTION_ID (recommended for Usage & Cost)
AZURE_COST_INCLUDE_ALL_RESOURCE_GROUPS=true
# Legacy single-RG setting is still supported:
AZURE_COST_RESOURCE_GROUP=
# Optional dashboard budget (sum across monitored RGs):
AZURE_COST_MONTHLY_BUDGET=
# Usage & Cost date range is selected in the dashboard. The backend queries
# Cost Management with timeframe=Custom and uses the same period for Azure Monitor metrics.
# Maximum accepted custom range: 366 days.
# Cost cache TTL; default 20 minutes (custom date ranges are cached independently):
AZURE_COST_CACHE_TTL_MS=1200000

# Entra ID - Admin tab authentication
# These identifiers are intentionally returned to the browser by /api/auth/config;
# they are not secrets. Use different values in TEST and PROD App Service settings.
ENTRA_TENANT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=api://<admin-api-client-id>/access_as_admin
ENTRA_AUDIENCE=api://<admin-api-client-id>
ENTRA_ALLOWED_EMAILS=go-cld-laltupati@kpmgdev.com
# Optional. Leave blank to use the current web-app origin.
ENTRA_REDIRECT_URI=
