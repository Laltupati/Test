{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*.{css,js,png,jpg,gif,svg,webp}", "/favicon.ico", "/favicon.svg", "/icons.svg"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
